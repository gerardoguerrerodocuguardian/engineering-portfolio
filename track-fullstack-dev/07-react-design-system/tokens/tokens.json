{
  "$description": "AdFlow design tokens. 'base' tokens are theme-independent; each entry under 'themes' overrides the semantic colour set.",
  "base": {
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px", "full": "9999px" },
    "font": {
      "family": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
      "size-sm": "0.875rem",
      "size-md": "1rem",
      "size-lg": "1.25rem",
      "weight-regular": "400",
      "weight-semibold": "600"
    },
    "duration": { "fast": "120ms", "normal": "200ms" },
    "z": { "popover": "1000", "modal": "1100", "toast": "1200" },
    "focus": { "width": "3px", "offset": "2px" }
  },
  "themes": {
    "light": {
      "bg": "#ffffff", "surface": "#f4f5f8", "surface-raised": "#ffffff",
      "fg": "#14171f", "fg-muted": "#4a5160", "border": "#767d8c", "border-subtle": "#d5d9e2",
      "primary": "#1f4fd6", "primary-hover": "#1a42b3", "primary-fg": "#ffffff",
      "danger": "#b3261e", "danger-hover": "#8f1e18", "danger-fg": "#ffffff",
      "focus": "#1f4fd6", "scrim": "rgba(15, 18, 24, 0.55)", "skeleton": "#e4e7ec", "skeleton-shine": "#f4f5f8",
      "neutral-bg": "#e9ebf0", "neutral-fg": "#2a2f3a",
      "success-bg": "#dff3e5", "success-fg": "#0b5c25",
      "warning-bg": "#fff1d6", "warning-fg": "#6b4300",
      "info-bg": "#e1ecff", "info-fg": "#1a3f9e",
      "danger-bg": "#fde4e2", "danger-text": "#8f1e18",
      "shadow": "0 8px 24px rgba(15, 18, 24, 0.18)"
    },
    "dark": {
      "bg": "#0f1218", "surface": "#181c25", "surface-raised": "#202531",
      "fg": "#eceff5", "fg-muted": "#aab1c2", "border": "#7b8397", "border-subtle": "#2f3646",
      "primary": "#7aa2ff", "primary-hover": "#9ab9ff", "primary-fg": "#0b1020",
      "danger": "#ff8a80", "danger-hover": "#ffa8a0", "danger-fg": "#1a0503",
      "focus": "#9ab9ff", "scrim": "rgba(0, 0, 0, 0.7)", "skeleton": "#262c3a", "skeleton-shine": "#323a4d",
      "neutral-bg": "#2a303d", "neutral-fg": "#e2e6ee",
      "success-bg": "#12381f", "success-fg": "#8fe3a8",
      "warning-bg": "#3d2c05", "warning-fg": "#ffd98a",
      "info-bg": "#14274f", "info-fg": "#a9c4ff",
      "danger-bg": "#4a1613", "danger-text": "#ffb4ac",
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.6)"
    },
    "high-contrast": {
      "bg": "#000000", "surface": "#000000", "surface-raised": "#000000",
      "fg": "#ffffff", "fg-muted": "#e6e6e6", "border": "#ffffff", "border-subtle": "#9a9a9a",
      "primary": "#ffe14d", "primary-hover": "#ffffff", "primary-fg": "#000000",
      "danger": "#ff9d96", "danger-hover": "#ffffff", "danger-fg": "#000000",
      "focus": "#4dd2ff", "scrim": "rgba(0, 0, 0, 0.85)", "skeleton": "#4d4d4d", "skeleton-shine": "#7a7a7a",
      "neutral-bg": "#000000", "neutral-fg": "#ffffff",
      "success-bg": "#000000", "success-fg": "#7dff9e",
      "warning-bg": "#000000", "warning-fg": "#ffe14d",
      "info-bg": "#000000", "info-fg": "#8fd8ff",
      "danger-bg": "#000000", "danger-text": "#ff9d96",
      "shadow": "0 0 0 2px #ffffff"
    }
  }
}
