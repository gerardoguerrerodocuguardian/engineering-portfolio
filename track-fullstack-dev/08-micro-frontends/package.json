{
  "name": "adflow-micro-frontends",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:shell": "npm run dev -w @adflow/shell",
    "dev:campaigns": "npm run dev -w @adflow/remote-campaigns",
    "dev:reports": "npm run dev -w @adflow/remote-reports",
    "build": "npm run build -w @adflow/remote-campaigns -w @adflow/remote-reports -w @adflow/shell",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium"
  },
  "devDependencies": {
    "@module-federation/vite": "^1.23.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
