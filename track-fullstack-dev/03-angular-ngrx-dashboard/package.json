{
  "name": "adflow-angular-ngrx-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "AdFlow campaign dashboard: Angular standalone + NgRx + Signals (fictional ad platform, demo only).",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n mock,web \"npm run mock\" \"ng serve\"",
    "start:web": "ng serve",
    "start:nestjs": "ng serve --configuration nestjs",
    "mock": "node mock-api/server.mjs",
    "build": "ng build",
    "build:nestjs": "ng build --configuration nestjs",
    "test": "jest",
    "test:ci": "jest --ci",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "gen:types": "openapi-typescript ../../shared/contracts/campaign-api.openapi.yaml -o src/app/core/api.generated.ts"
  },
  "dependencies": {
    "@angular/common": "20.3.2",
    "@angular/compiler": "20.3.2",
    "@angular/core": "20.3.2",
    "@angular/forms": "20.3.2",
    "@angular/platform-browser": "20.3.2",    "@angular/platform-browser-dynamic": "20.3.2",
    "@angular/platform-server": "20.3.2",
    "@angular/router": "20.3.2",
    "@angular/ssr": "20.3.2",
    "@ngrx/effects": "^20.0.0",
    "@ngrx/entity": "^20.0.0",
    "@ngrx/store": "^20.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.2",
    "@angular/cli": "20.3.2",
    "@angular/compiler-cli": "20.3.2",
    "@playwright/test": "^1.50.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^15.0.0",
    "openapi-typescript": "^7.0.0",
    "typescript": "~5.9.0"
  }
}
