# Copy to .env. All values are synthetic placeholders for local development.
PORT=3000
MONGODB_URI=mongodb://localhost:27017/adflow
# Dev token issuer (disable in any real environment and validate tokens from a real IdP)
AUTH_DEV_ISSUER=true
JWT_ISSUER=https://auth.adflow.local
JWT_AUDIENCE=adflow-campaign-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
# Optional PEM (RSA private key). If empty, an ephemeral keypair is generated at boot.
DEV_JWT_PRIVATE_KEY=
# Synthetic dev users (username:password:ROLE, comma separated)
DEV_USERS=admin@adflow.test:change-me-admin:ADMIN,advertiser@adflow.test:change-me-adv:ADVERTISER
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
