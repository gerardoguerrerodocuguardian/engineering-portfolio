{
  "name": "adflow-angular-realtime-console",
  "version": "1.0.0",
  "private": true,
  "description": "AdFlow real-time ad-events console: Angular standalone + Signals + zoneless + Web Worker (fictional ad platform, demo only).",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n mock,web \"npm run mock\" \"ng serve\"",
    "start:web": "ng serve",
    "mock": "node mock-server/server.mjs",
    "serve:dist": "STATIC_DIR=dist/adflow-realtime-console/browser node mock-server/server.mjs",
    "build": "ng build",
    "test": "jest",
    "test:ci": "jest --ci",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "bench": "node --no-warnings scripts/bench-aggregator.mjs",
    "bench:browser": "node scripts/bench-browser.mjs"
  },
  "dependencies": {
    "@angular/cdk": "20.2.12",
    "@angular/common": "20.3.2",
    "@angular/compiler": "20.3.2",
    "@angular/core": "20.3.2",
    "@angular/forms": "20.3.2",
    "@angular/platform-browser": "20.3.2",
    "@angular/platform-browser-dynamic": "20.3.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.2",
    "@angular/cli": "20.3.2",
    "@angular/compiler-cli": "20.3.2",
    "@playwright/test": "^1.50.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^15.0.0",
    "typescript": "~5.9.0",
    "ws": "^8.18.0"
  }
}
