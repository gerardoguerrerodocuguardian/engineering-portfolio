{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning",
      "AdFlow.Audit": "Information"
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Auth": {
      "Issuer": "https://gateway.adflow.example",
      "Audience": "adflow-api",
      "Authority": "",
      "SigningKey": "",
      "ClockSkewSeconds": 30,
      "DevTokens": { "Enabled": false, "LifetimeMinutes": 15 }
    },
    "RateLimit": {
      "Enabled": true,
      "IpPermitLimit": 300,
      "IpWindowSeconds": 60,
      "IpSegments": 6,
      "ClientTokenLimit": 60,
      "ClientTokensPerPeriod": 30,
      "ClientReplenishSeconds": 10,
      "ConcurrencyLimit": 4,
      "DefaultRetryAfterSeconds": 5
    },
    "Abuse": {
      "Enabled": true,
      "FailureThreshold": 10,
      "WindowSeconds": 60,
      "BanSeconds": 300,
      "CountStatusCodes": [ 401, 403, 429 ]
    },
    "Validation": {
      "Enabled": true,
      "MaxBodyBytes": 1048576,
      "MaxPathLength": 2048,
      "MaxQueryLength": 4096,
      "MaxHeaderCount": 64,
      "MaxHeaderValueLength": 8192,
      "AllowedMethods": [ "GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS" ],
      "StripHeaders": [ "Authorization", "X-Api-Key", "Forwarded", "X-Real-IP", "Via", "Proxy-Authorization" ],
      "StripHeaderPrefixes": [ "X-User-", "X-Client-", "X-Auth-", "X-Forwarded-", "X-Original-", "X-Gateway-" ]
    },
    "IpFilter": {
      "Enabled": true,
      "Deny": [],
      "Allow": [],
      "AdminPathPrefix": "/admin",
      "AdminAllow": [ "127.0.0.1/32", "::1/128", "10.0.0.0/8" ]
    },
    "Https": { "RedirectToHttps": false, "HttpsPort": 8443, "Hsts": false, "HstsMaxAgeDays": 365 },
    "Forwarded": { "KnownProxies": [], "KnownNetworks": [], "ForwardLimit": 1 },
    "ApiKeys": {
      "Enabled": true,
      "Clients": [
        {
          "Id": "orbit",
          "KeyHashes": [ "ccc27ef324df25239016c9ff225d5896d833b84893b7bc9e39a6660cf19b431b" ],
          "Scopes": [ "campaigns.read" ],
          "DailyQuota": 1000
        }
      ]
    },
    "Cache": { "Enabled": true, "TtlSeconds": 5 },
    "Waf": { "Mode": "Block", "InspectBody": true, "MaxInspectBytes": 16384 },
    "Resilience": {
      "Enabled": true,
      "RetryCount": 2,
      "BaseDelayMs": 100,
      "BreakerFailureRatio": 0.5,
      "BreakerMinThroughput": 8,
      "BreakerSamplingSeconds": 30,
      "BreakerBreakSeconds": 15
    },
    "Timeouts": { "DefaultSeconds": 15, "ReportsSeconds": 30 },
    "Audit": { "FilePath": "", "RingSize": 500 }
  },
  "ReverseProxy": {
    "Routes": {
      "campaigns-v1-read": {
        "ClusterId": "campaigns",
        "AuthorizationPolicy": "campaigns-read",
        "RateLimiterPolicy": "client-bucket",
        "OutputCachePolicy": "safe-get",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/v1/campaigns/{**rest}", "Methods": [ "GET", "HEAD" ] },
        "Transforms": [
          { "PathRemovePrefix": "/api/v1" },
          { "ResponseHeader": "Deprecation", "Set": "true", "When": "Always" },
          { "ResponseHeader": "Sunset", "Set": "Wed, 30 Jun 2027 23:59:59 GMT", "When": "Always" }
        ]
      },
      "campaigns-v1-write": {
        "ClusterId": "campaigns",
        "AuthorizationPolicy": "campaigns-write",
        "RateLimiterPolicy": "client-bucket",
        "Timeout": "00:00:10",
        "Metadata": { "MaxBodyBytes": "65536", "RequiredContentType": "application/json" },
        "Match": { "Path": "/api/v1/campaigns/{**rest}", "Methods": [ "POST", "PUT", "PATCH", "DELETE" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      },
      "campaigns-v2-read": {
        "ClusterId": "campaigns",
        "AuthorizationPolicy": "campaigns-read",
        "RateLimiterPolicy": "client-bucket",
        "OutputCachePolicy": "safe-get",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/v2/campaigns/{**rest}", "Methods": [ "GET", "HEAD" ] },
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "reports-v1-read": {
        "ClusterId": "reports",
        "AuthorizationPolicy": "reports-read",
        "RateLimiterPolicy": "reports-concurrency",
        "TimeoutPolicy": "reports",
        "Match": { "Path": "/api/v1/reports/{**rest}", "Methods": [ "GET", "HEAD" ] },
        "Transforms": [ { "PathRemovePrefix": "/api/v1" } ]
      }
    },
    "Clusters": {
      "campaigns": {
        "LoadBalancingPolicy": "PowerOfTwoChoices",
        "HttpRequest": { "ActivityTimeout": "00:00:15" },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/healthz" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "2" },
        "Destinations": {
          "d1": { "Address": "http://campaigns-1:8080/" },
          "d2": { "Address": "http://campaigns-2:8080/" }
        }
      },
      "reports": {
        "LoadBalancingPolicy": "RoundRobin",
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/healthz" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:30" }
        },
        "Destinations": {
          "d1": { "Address": "http://reports:8080/" }
        }
      }
    }
  }
}
