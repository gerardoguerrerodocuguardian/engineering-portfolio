# Only needed for the live Anthropic provider. Never commit a real key.
ANTHROPIC_API_KEY=
# Default model (override freely)
AGENT_MODEL=claude-sonnet-5-5
# Guard rails
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOTAL_TOKENS=60000
AGENT_MAX_COST_USD=0.25
# Optional price overrides, USD per 1M tokens (estimates only)
PRICE_INPUT_PER_MTOK=2
PRICE_OUTPUT_PER_MTOK=10
